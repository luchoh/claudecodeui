# Claude Code UI Development Environment
# Copy this file to .env.dev and fill in your values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
PORT=3001

# Frontend Vite dev server port
VITE_PORT=5173

# Claude CLI path (uncomment if not using default "claude")
# CLAUDE_CLI_PATH=claude

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file (optional, defaults to project root)
# DATABASE_PATH=/path/to/your/custom/auth.db

# =============================================================================
# CONTEXT CONFIGURATION
# =============================================================================

# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# =============================================================================
# API KEYS (for AI integrations)
# =============================================================================

# API keys are only needed if you don't have the CLI tools authenticated.
# If Claude Code CLI or Codex CLI are already logged in, leave these commented out.
# Setting them to empty strings will BREAK credential resolution.
# ANTHROPIC_API_KEY=                  # Format: sk-ant-api03-...
# PERPLEXITY_API_KEY=                 # Format: pplx-...
# OPENAI_API_KEY=                     # Format: sk-proj-...
# GOOGLE_API_KEY=                     # For Google Gemini models
# MISTRAL_API_KEY=                    # For Mistral AI models
# XAI_API_KEY=                        # For xAI models
# GROQ_API_KEY=                       # For Groq models
OPENROUTER_API_KEY=                   # Optional: For OpenRouter models
GITHUB_API_KEY=                       # Optional: For GitHub features. Format: ghp_... or github_pat_...

# =============================================================================
# PLATFORM MODE (optional)
# =============================================================================

# VITE_IS_PLATFORM=false
# ALLOW_PLATFORM_MODE=false           # Required when VITE_IS_PLATFORM=true (SEC-017)

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# SEC-001: JWT Secret (REQUIRED - minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# SEC-002: Token expiry settings
# ACCESS_TOKEN_EXPIRY=15m             # Short-lived access token (default: 15 minutes)
# REFRESH_TOKEN_EXPIRY_DAYS=7         # Refresh token lifetime (default: 7 days)

# SEC-003: CORS allowed origins (comma-separated explicit URLs)
# ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# SEC-003b: CORS allowed networks (CIDR notation for LAN access)
# Allows any IP in the specified ranges to make cross-origin requests
# ALLOWED_NETWORKS=10.10.10.0/24,192.168.3.0/24

# SEC-004: Server bind address (default: 127.0.0.1 for localhost only)
# Set to 0.0.0.0 to expose to network (requires reverse proxy in production)
# BIND_HOST=127.0.0.1

# SEC-006: Workspace root directories (comma-separated, for multi-root support)
# WORKSPACES_ROOT=/Users/yourname/projects,/Users/yourname/work

# SEC-008: System update endpoint (disabled by default)
# ENABLE_SYSTEM_UPDATE=false

# SEC-009: Rate limiting configuration
# RATE_LIMIT_WINDOW=60000             # Time window in ms (default: 1 minute)
# RATE_LIMIT_MAX=100                  # Max requests per window (default: 100)
# RATE_LIMIT_AUTH_MAX=10              # Max auth attempts per window (default: 10)

# SEC-011: Credential storage provider
# CREDENTIAL_PROVIDER=keychain        # Options: keychain (macOS), env (fallback)

# SEC-012: PTY idle timeout in milliseconds (default: 5 minutes)
# PTY_IDLE_TIMEOUT=300000

# =============================================================================
# MITM PROXY (optional - call-home monitoring)
# =============================================================================

# Enable MITM proxy for server/client egress
MITM_PROXY_ENABLE=0

# Proxy listener port (must match devenv mitmproxy process)
MITM_PROXY_PORT=8082
MITM_PROXY_URL=http://127.0.0.1:8082

# Path to mitmproxy CA cert (created by devenv up mitmproxy)
MITM_PROXY_CA_CERT=.devenv/mitmproxy/mitmproxy-ca-cert.pem
